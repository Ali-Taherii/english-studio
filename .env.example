# Copy to .env.local. Real values live in Vercel / GitHub environment settings, never in git.

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase: `npm run db:start` prints the local values.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Email (Phase 1: contact form notifications)
RESEND_API_KEY=
# Sender, on a domain verified in Resend: "English Studio <hello@your-domain>"
EMAIL_FROM=
# Where contact-form notifications go
TEACHER_EMAIL=
